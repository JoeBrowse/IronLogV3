{
  "name": "Iron Log",
  "short_name": "Iron Log",
  "description": "Offline-first gym workout tracker. No account, no cloud, no ads.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#15171A",
